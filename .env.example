# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/flightconnect

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Admin login (change before use)
ADMIN_NAME=Admin User
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
EMAIL_FROM=FlightConnect <no-reply@flightconnect.in>
ADMIN_EMAIL=admin@flightconnect.in

# Frontend URL
FRONTEND_URL=https://www.fareoracle.com

# SerpAPI (Google Flights data)
SERPAPI_KEY=change_this_serpapi_key
